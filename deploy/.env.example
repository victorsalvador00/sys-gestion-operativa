# Copy to deploy/.env and replace the values. Never commit .env.

# --- Local Postgres (docker-compose.dev.yml) ---
POSTGRES_DB=sgo
POSTGRES_USER=sgo
POSTGRES_PASSWORD=change-me
# Host port for the API container (change it if 8080 is taken)
API_PORT=8080

# --- API (prefix SGO__ maps to configuration keys) ---
ASPNETCORE_ENVIRONMENT=Development
# Production: add sslmode=require
SGO__ConnectionStrings__Default=Host=localhost;Port=5432;Database=sgo;Username=sgo;Password=change-me
# Used from B-03 onward
SGO__Jwt__Key=replace-with-a-random-key-of-at-least-32-bytes
SGO__Jwt__Issuer=sgo
SGO__Jwt__Audience=sgo
# Only used by the first seed (B-02)
SGO__Seed__AdminEmail=admin@example.com
SGO__Seed__AdminPassword=ChangeMe12345
